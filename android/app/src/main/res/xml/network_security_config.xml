<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. Phase 0 makes no network calls; this is the policy the
     Phase 1 agent will run with (and targetSdk 37 adds Certificate Transparency). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
