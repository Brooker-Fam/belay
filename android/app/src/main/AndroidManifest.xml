<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The inventory. A device owner gets no exemption from package visibility. Play's
         policy for this permission only applies to apps distributed on Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- The always-on service. Device owners may use the systemExempted type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The managed notice. The device owner grants this to itself by policy, so it can't
         be revoked in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Usage access: granted over adb by provision.sh, for Phase 3. A device owner can't
         grant it to itself. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Phase 3: screen time's boundaries (a schedule starts, a limit runs out) need exact
         alarms. The battery allowlist provision.sh adds already exempts Belay; this normal
         permission keeps them exact if that entry is ever lost (docs/platform-notes.md S6).
         Play's restriction of it to alarm apps doesn't apply: Belay isn't on Play. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Fallback when provision.sh couldn't add the battery exemption: the system dialog. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Talking to the family's own server, and only that (sync/DeviceApi.kt). A server on
         the home network needs ACCESS_LOCAL_NETWORK (targetSdk 37), granted by policy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only to scan the enrollment QR code, and only if the person scanning allows it:
         never granted by policy, and denied by policy whenever the enrollment screen is
         closed (enroll/CameraGate.kt). Typing the code works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Phase 4: where the phone is, only while the family has location on (or lost mode, or
         the one fix a kid shares with "I need help"). Declared, but granted by policy only
         then, and denied by policy otherwise, so Settings shows Belay without location and the
         kid can't grant it either (core's CategoryPermissions; docs/platform-notes.md L1).
         Single fixes from the platform's LocationManager, never Play services code. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- Phase 4: keeps the phone awake for one fix, at most 75 seconds (LocationCollector).
         Phase 5: and the proximity sensor's screen-off lock during a call (calls/CallActivity.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Phase 5: calls, only while the family has calls on. Declared, but granted by policy only
         then and denied by policy otherwise (core's CategoryPermissions), so the dialer role can
         neither grant nor revoke them (docs/platform-notes.md T1). CALL_PHONE places calls with
         TelecomManager.placeCall; READ_CALL_LOG and PROCESS_OUTGOING_CALLS let Belay see a call to
         911 or 988 its own dialer didn't place (the preloaded dialer, the lock screen), for the
         2-hour callback window, and show calls with 911, 988 and private numbers in its recent
         calls only while Android's own call log has them. Nothing read with them is sent.
         Belay declares no contacts, SMS, microphone or phone-state permission: the dialer role
         would grant whatever it declares. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- The incoming-call screen over the lock screen, and Belay's own ringer's vibration. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".BelayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Belay">

        <!-- Google Play's declaration for monitoring apps (its stalkerware policy): a
             meta-data entry, value child_monitoring. Belay isn't distributed on Play, but
             it says plainly what Belay is to anything that checks. -->
        <meta-data
            android:name="isMonitoringTool"
            android:value="child_monitoring" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Connect to a Belay server: scan its QR code or type it. Only Belay opens it. -->
        <activity
            android:name=".ui.EnrollActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Phase 6: the recovery key, for a parent whose Belay server is gone. Only Belay opens it. -->
        <activity
            android:name=".ui.RecoveryActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- provision.sh enrolls the phone through this receiver. Exported, but only senders
             holding WRITE_SECURE_SETTINGS (the adb shell; ordinary apps can't) can reach it. -->
        <receiver
            android:name=".EnrollReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="family.brooker.belay.ENROLL" />
            </intent-filter>
        </receiver>

        <!-- Android 12+ managed provisioning (QR code, NFC, zero-touch). Only the system,
             which holds BIND_DEVICE_ADMIN, can start these. -->
        <activity
            android:name=".provisioning.GetProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".provisioning.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- The receivers below are not exported: they only take broadcasts from the system.
             DEVICE_OWNER_CHANGED is sent with FLAG_RECEIVER_INCLUDE_BACKGROUND, so it reaches
             this manifest receiver the moment `dpm set-device-owner` succeeds. -->
        <receiver
            android:name=".OwnerChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phase 2: Belay's own alarm for when a pause or repair time ends; Phase 3: or for
             screen time's next boundary. -->
        <receiver
            android:name=".enforce.PolicyTimerReceiver"
            android:exported="false" />

        <!-- Phase 4: Belay's own alarm for the next periodic or lost-mode fix. -->
        <receiver
            android:name=".location.LocationTimerReceiver"
            android:exported="false" />

        <!-- Phase 3: the clock or the time zone changed. Both still reach manifest receivers
             (the implicit broadcast exceptions); only the system sends them. -->
        <receiver
            android:name=".screentime.ClockChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Phase 6: Android's answer to Belay's own update (a PackageInstaller session). Only
             Belay's PendingIntent reaches it. A device owner installs without asking anyone,
             so Belay declares no REQUEST_INSTALL_PACKAGES (docs/platform-notes.md I2). -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!-- One of the two package broadcasts a manifest receiver still gets. Added,
             replaced and removed go to the runtime receiver (inventory/PackageWatcher.kt). -->
        <receiver
            android:name=".inventory.PackageRemovedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Lint only knows the exact-alarm route to systemExempted. Belay qualifies as the
             device owner (docs/platform-notes.md), and never starts this service otherwise. -->
        <!-- Bound by the system for as long as Belay is device owner. -->
        <service
            android:name=".service.BelayAdminService"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.BelayService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            tools:ignore="ForegroundServicePermission" />

        <!-- Phase 5: Belay's dialer. Disabled here, and enabled only while the policy has calls
             (calls/Dialer.kt), so with calls off Belay isn't a dialer at all; disabling them again
             makes Android drop Belay from the dialer role even when there's no other dialer to
             give it back to. What the dialer role requires (PermissionController roles.xml, AOSP
             17): an activity for ACTION_DIAL, one for ACTION_DIAL with tel:, and an exported
             InCallService behind BIND_INCALL_SERVICE with IN_CALL_SERVICE_UI (docs/platform-notes.md T1).
             IN_CALL_SERVICE_RINGING: Belay plays the ringtone itself, so a refused call never rings (T5). -->
        <service
            android:name=".calls.BelayInCallService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Telecom asks the default dialer's screening service about incoming calls with a
             caller id, before they ring (T4). Only Telecom holds BIND_SCREENING_SERVICE. -->
        <service
            android:name=".calls.BelayCallScreeningService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- The dial pad, contacts and recent calls; other apps open it with ACTION_DIAL or a
             tel: link. -->
        <activity
            android:name=".calls.DialerActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/calls_launcher_label"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- The dialer's own icon in the launcher, only while calls is on. -->
        <activity-alias
            android:name=".calls.DialerLauncher"
            android:enabled="false"
            android:exported="true"
            android:label="@string/calls_launcher_label"
            android:targetActivity=".calls.DialerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Telecom's outgoing-call broadcast, sent only to holders of PROCESS_OUTGOING_CALLS and
             from the system: a call to 911 or 988 through any dialer opens the callback window. -->
        <receiver
            android:name=".calls.OutgoingCallReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <!-- The incoming-call and in-call screen, over the lock screen. Only Belay opens it. -->
        <activity
            android:name=".calls.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="family.brooker.belay.call"
            android:turnScreenOn="true" />

        <!-- Answer, Decline and Hang up from the call notifications: only Belay's own PendingIntents. -->
        <receiver
            android:name=".calls.CallActionReceiver"
            android:exported="false" />

        <!-- No downloadable emoji font: Compose's EmojiCompat would ask Google Play
             services' font provider for one, and Belay uses no Play services (CLAUDE.md,
             principle 5). The phone's own emoji font still works. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
